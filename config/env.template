# Copy to config/.env. Secrets only — everything else is in configuration.yaml,
# exactly as it is for every other Fred component. A deployed pod gets this from
# a Secret and the YAML from a ConfigMap.

# Which configuration this pod reads. The Makefile passes $ENV_FILE; this points
# at the rest.
CONFIG_FILE="./config/configuration.yaml"

# The confidential client's secret. Its variable name is not fixed by the SDK —
# configuration.yaml's `security.m2m.secret_env_var` chooses it.
FRED_KB_CLIENT_SECRET="" # Fill with the secret of your deployment client.

# A private certificate authority, ADDED to what this pod already trusts.
# Never $SSL_CERT_FILE, which replaces the whole trust store.
# WEBDAV_KB_CA_FILE="/etc/ssl/private-ca/corporate-root.pem"

# Only the developer tool reads this — a run gets its password from the
# configuration a team filled in, never from the pod's environment.
WEBDAV_KB_PASSWORD=""
