# The WebDAV Knowledge Base on the local k3d instance of fred-deployment-factory,
# which runs
#   make k3d-app DIR=<this checkout> [FRED_LIBS=local]
# and passes the kube context, the namespace, FRED_LIBS and FRED_REPO. The chart
# is Fred's generic knowledge-base: the published one, or with FRED_LIBS=local the
# one in the fred checkout (fred-deployment-factory's docs/LOCAL-DEVELOPMENT.md,
# "Work on unreleased fred"). deploy/k3d/build writes the image's values (K3D_IMAGE_VALUES).
{{- $local := eq (env "FRED_LIBS") "local" }}
releases:
  - name: knowledge-base-webdav
    chart: {{ if $local }}{{ env "FRED_REPO" }}/deploy/charts/knowledge-base{{ else }}oci://ghcr.io/thalesgroup/fred-helm/knowledge-base{{ end }}
    {{- if not $local }}
    # The first fred chart release carrying knowledge-base.
    version: 3.5.0
    {{- end }}
    values:
      - ../values.yaml
      - values.yaml
      {{- with env "K3D_IMAGE_VALUES" }}
      - {{ . | quote }}
      {{- end }}
